[Unit]
Description=NFL EDGE schedule (America/New_York)

[Timer]
# NFL-native slots (ET only — America/New_York):
# Sun 11:35 ET — after the ~11:30 inactives leak, before the 13:00 window; one run covers all Sunday windows.
# Thu + Mon 18:50 ET — after the 90-min-pre-kick inactives for 20:15 primetime.
# One customer proposal per ET day (pipeline gate).
OnCalendar=Sun *-*-* 11:35:00 America/New_York
OnCalendar=Thu,Mon *-*-* 18:50:00 America/New_York
AccuracySec=1s
Persistent=false
Unit=nfl-edge-live.service

[Install]
WantedBy=timers.target
